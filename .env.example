# Copy to .env and fill in. docker-compose.yml reads these. Never commit .env.
# MongoDB for the CyxWiz API container (local: mongodb://host.docker.internal:27017/cyxwiz)
CYXWIZ_API_MONGODB_URI=
# Must equal the CyxWiz API JWT_SECRET and the central server's [jwt].secret
JWT_SECRET=
POSTGRES_PASSWORD=
# Password of the test account the storage nodes sign in with (CYXWIZ_EMAIL)
CYXCLOUD_NODE_PASSWORD=
